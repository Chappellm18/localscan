# Copy to .env and fill in for local dev.
# Both the Next.js app and the Rust workers read from this shape (workers
# via std env vars — see each worker's README/main.rs for exact names).

REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://localscan:localscan@127.0.0.1:5432/localscan

# Only needed once Phase 2 auth/billing lands (DESIGN.md §9):
# CLERK_SECRET_KEY=
# STRIPE_SECRET_KEY=
